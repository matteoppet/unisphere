rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and academic telemetry
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Email verifications and notifications
    match /emailVerifications/{verificationId} {
      allow read, write: if true;
    }
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Squads Hub: Main squad document
    match /squads/{squadId} {
      allow read, write: if true;

      // Squad members
      match /members/{memberId} {
        allow read, write: if true;
      }

      // Live Lock-In presence
      match /presence/{presenceId} {
        allow read, write: if true;
      }

      // Squad activity feed
      match /activities/{activityId} {
        allow read, write: if true;
      }

      // Historical ghost racing sessions
      match /sessions/{sessionId} {
        allow read, write: if true;
      }
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
