rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID; legacy email-slug docs allowed read/delete only for one-time migration)
// Fields:
//   - uid: string (optional, <= 254 chars) - Firebase Auth UID
//   - authUid: string (optional, <= 254 chars) - Firebase Auth UID
//   - email: string (optional, 4..254 chars) - user email address
//   - name: string (optional, <= 120 chars) - display name
//   - studentId: string (optional, <= 64 chars) - university matricola / ID
//   - authProvider: string (optional, <= 32 chars) - 'email'
//   - emailVerified: bool (optional) - whether email was verified
//   - degreeLevel: string (optional, <= 64 chars)
//   - degreeName: string (optional, <= 160 chars)
//   - degreeType: string (optional, <= 64 chars)
//   - totalTargetCFU: number (optional, 0..1000)
//   - enrolledYear: string|number (optional, <= 32 chars or 0..3000)
//   - academicYear: string (optional, <= 64 chars)
//   - institution: string (optional, <= 160 chars)
//   - status: string (optional, <= 64 chars)
//   - currentSession: string (optional, <= 64 chars)
//   - weeklyGoalHours: number (optional, 0..168)
//   - avatarUrl: string (optional, <= 2048 chars)
//   - logoUrl: string (optional, <= 2048 chars)
//   - thesisPointsExpected: number (optional, 0..100)
//   - courses: list (optional, <= 200 items)
//   - studyLogs: list (optional, <= 2000 items)
//   - assignments: list (optional, <= 500 items)
//   - quickNotes: string|list (optional, <= 20000 chars or <= 500 items)
//   - checklist: string|list (optional, <= 20000 chars or <= 500 items)
//   - resourceLinks: list (optional, <= 200 items)
//   - activeSquadId: string|null (optional, <= 128 chars)
//   - squadIds: list (optional, <= 50 items)
//   - xp: number (optional, 0..100000000)
//   - currentStreak: number (optional, 0..10000)
//   - minutesStudiedThisWeek: number (optional, 0..10080)
//   - tasksCompletedThisWeek: number (optional, 0..10000)
//   - lastActiveDate: string|null (optional, <= 64 chars)
//   - createdAt: string|number|timestamp (optional, immutable once set)
//   - updatedAt: string|number|timestamp (optional)
//   - updatedBy: string (optional, <= 128 chars)
//   - migratedFromEmailId: string (optional, <= 254 chars)
//   - migratedAt: string|number|timestamp (optional)
//   Note: passwordHash is strictly forbidden on all writes.
//
// Collection: friendLookups
// Document ID: {emailHash} (64-char lowercase hex SHA-256 of normalized email)
// Fields:
//   - uid: string (required, == request.auth.uid, <= 254 chars)
//   - displayName: string (required, <= 120 chars)
//   - emailHash: string (required, == emailHash)
//   - updatedAt: string|number|timestamp (optional)
//
// Collection: friendProfiles
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required, == request.auth.uid, <= 254 chars)
//   - name: string (optional, <= 120 chars)
//   - displayName: string (optional, <= 120 chars)
//   - institution: string (optional, <= 160 chars)
//   - degreeName: string (optional, <= 160 chars)
//   - degreeType: string (optional, <= 80 chars)
//   - academicYear: string (optional, <= 64 chars)
//   - status: string (optional, <= 64 chars)
//   - weeklyGoalHours: number (optional, 0..168)
//   - minutesThisWeek: number (optional, 0..10080)
//   - tasksThisWeek: number (optional, 0..10000)
//   - currentStreak: number (optional, 0..10000)
//   - xp: number (optional, 0..100000000)
//   - dailyMinutes: map (optional, <= 14 entries)
//   - subjectMinutes: map (optional, <= 50 entries)
//   - courses: list (optional, <= 200 items, grade-free summaries)
//   - updatedAt: string|number|timestamp (optional)
//   Note: grades and passwordHash are strictly forbidden.
//
// Collection: friendships
// Document ID: {friendshipId} (canonical sorted pair uidA__uidB, <= 512 chars)
// Fields:
//   - id: string (optional, <= 512 chars)
//   - users: list of 2 strings (required, size == 2) - [uidA, uidB] participant UIDs
//   - requesterUid: string (required, 1..254 chars, immutable)
//   - requesterName: string (optional, <= 120 chars)
//   - recipientUid: string (required, 1..254 chars, immutable)
//   - recipientName: string (optional, <= 120 chars)
//   - requesterEmail: string (optional, <= 254 chars)
//   - recipientEmail: string (optional, <= 254 chars)
//   - status: string (required, 'pending' | 'accepted')
//   - createdAt: string|number|timestamp (optional)
//   - updatedAt: string|number|timestamp (optional)
//
// Collection: squadInvites
// Document ID: {code} (4..20 chars uppercase alphanumeric/hyphen invite code)
// Fields:
//   - code: string (required, == code)
//   - squadId: string (required, <= 128 chars)
//   - createdBy: string (required, == request.auth.uid)
//   - createdAt: string|number|timestamp (optional)
//
// Collection: squads
// Document ID: {squadId}
// Fields:
//   - id: string (optional, <= 128 chars)
//   - name: string (required on create, 1..100 chars)
//   - code: string (required on create, 4..20 chars)
//   - description: string (optional, <= 500 chars)
//   - weeklyGoalHours: number (optional, 1..1000)
//   - nextSession: map|null (optional, <= 10 keys)
//   - createdAt: string|number|timestamp (optional)
//   - createdBy: string (required on create, <= 254 chars)
//   - creatorName: string (optional, <= 120 chars)
//   - memberCount: number (optional, 0..500)
//   - memberUids: list (required on create, <= 200 items)
//   - updatedAt: string|number|timestamp (optional)
//
// Subcollections under /squads/{squadId}:
//   - members/{memberId}: uid, displayName, email, color, elo, minutesThisWeek, tasksThisWeek, currentStreak, joinedAt, updatedAt, avatarUrl, dailyMinutes, subjectMinutes, status, liveSubject, liveStartedAt, nudgeCount, lastNudgedBy, lastNudgedAt
//   - presence/{memberId}: uid, displayName, status, subject, startedAt, updatedAt
//   - activities/{activityId}: id, uid, displayName, type, text, courseName, url, title, status, createdAt, updatedAt
//   - sessions/{sessionId}: id, uid, displayName, durationMinutes, subject, courseName, completedAt, createdAt
//
// Legacy / Deprecated Collections (Locked Down):
//   - emailVerifications/{docId}: read/write denied
//   - mail/{docId}: read/write denied
//   - test/{docId}: read/write denied
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email.size() > 0
        ? request.auth.token.email.lower()
        : '';
    }

    function legacyEmailDocId() {
      return authEmail() != '' ? authEmail().replace('/', '_') : '';
    }

    function isUserDocOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isLegacyEmailOwner(userId) {
      return isSignedIn() &&
             legacyEmailDocId() != '' &&
             legacyEmailDocId() == userId;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is bool;
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalStringOrList(data, field, maxStrLen, maxListSize) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() <= maxStrLen) ||
             (data[field] is list && data[field].size() <= maxListSize);
    }

    function isValidOptionalTimestampField(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is timestamp ||
             (data[field] is string && data[field].size() <= 64) ||
             (data[field] is number && data[field] >= 0);
    }

    function isAcceptedFriendOf(targetUserId) {
      let pairId = request.auth.uid < targetUserId
        ? request.auth.uid + '__' + targetUserId
        : targetUserId + '__' + request.auth.uid;
      return isSignedIn() &&
             pairId.size() <= 512 &&
             exists(/databases/$(database)/documents/friendships/$(pairId)) &&
             get(/databases/$(database)/documents/friendships/$(pairId)).data.status == 'accepted';
    }

    function isSquadMember(squadId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/squads/$(squadId)) &&
             request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.memberUids;
    }

    function isLegacySquadMember(squadId) {
      return isSignedIn() &&
             legacyEmailDocId() != '' &&
             exists(/databases/$(database)/documents/squads/$(squadId)) &&
             legacyEmailDocId() in get(/databases/$(database)/documents/squads/$(squadId)).data.memberUids;
    }

    function isSquadCreator(squadId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/squads/$(squadId)) &&
             get(/databases/$(database)/documents/squads/$(squadId)).data.createdBy == request.auth.uid;
    }

    function isLegacySquadCreator(squadId) {
      return isSignedIn() &&
             legacyEmailDocId() != '' &&
             exists(/databases/$(database)/documents/squads/$(squadId)) &&
             get(/databases/$(database)/documents/squads/$(squadId)).data.createdBy == legacyEmailDocId();
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserPayload(data, userId) {
      let allowedKeys = [
        'uid', 'authUid', 'email', 'name', 'studentId',
        'authProvider', 'emailVerified', 'degreeLevel', 'degreeName',
        'degreeType', 'totalTargetCFU', 'enrolledYear', 'academicYear',
        'institution', 'status', 'currentSession', 'weeklyGoalHours',
        'avatarUrl', 'logoUrl', 'thesisPointsExpected', 'courses',
        'studyLogs', 'assignments', 'quickNotes', 'checklist',
        'resourceLinks', 'activeSquadId', 'squadIds', 'xp',
        'currentStreak', 'minutesStudiedThisWeek', 'tasksCompletedThisWeek',
        'lastActiveDate', 'createdAt', 'updatedAt', 'updatedBy',
        'migratedFromEmailId', 'migratedAt'
      ];
      return userId is string &&
             userId.size() > 0 &&
             userId.size() <= 254 &&
             data.keys().hasOnly(allowedKeys) &&
             (!('email' in data) || (data.email is string && data.email.size() > 3 && data.email.size() <= 254)) &&
             isValidOptionalString(data, 'uid', 254) &&
             isValidOptionalString(data, 'authUid', 254) &&
             isValidOptionalString(data, 'name', 120) &&
             isValidOptionalString(data, 'studentId', 64) &&
             isValidOptionalString(data, 'authProvider', 32) &&
             isValidOptionalBool(data, 'emailVerified') &&
             isValidOptionalString(data, 'degreeLevel', 64) &&
             isValidOptionalString(data, 'degreeName', 160) &&
             isValidOptionalString(data, 'degreeType', 64) &&
             isValidOptionalNumber(data, 'totalTargetCFU', 0, 1000) &&
             (!('enrolledYear' in data) || data.enrolledYear == null || (data.enrolledYear is string && data.enrolledYear.size() <= 32) || (data.enrolledYear is number && data.enrolledYear >= 0 && data.enrolledYear <= 3000)) &&
             isValidOptionalString(data, 'academicYear', 64) &&
             isValidOptionalString(data, 'institution', 160) &&
             isValidOptionalString(data, 'status', 64) &&
             isValidOptionalString(data, 'currentSession', 64) &&
             isValidOptionalNumber(data, 'weeklyGoalHours', 0, 168) &&
             isValidOptionalString(data, 'avatarUrl', 2048) &&
             isValidOptionalString(data, 'logoUrl', 2048) &&
             isValidOptionalNumber(data, 'thesisPointsExpected', 0, 100) &&
             isValidOptionalList(data, 'courses', 200) &&
             isValidOptionalList(data, 'studyLogs', 2000) &&
             isValidOptionalList(data, 'assignments', 500) &&
             isValidOptionalStringOrList(data, 'quickNotes', 20000, 500) &&
             isValidOptionalStringOrList(data, 'checklist', 20000, 500) &&
             isValidOptionalList(data, 'resourceLinks', 200) &&
             isValidOptionalString(data, 'activeSquadId', 128) &&
             isValidOptionalList(data, 'squadIds', 50) &&
             isValidOptionalNumber(data, 'xp', 0, 100000000) &&
             isValidOptionalNumber(data, 'currentStreak', 0, 10000) &&
             isValidOptionalNumber(data, 'minutesStudiedThisWeek', 0, 10080) &&
             isValidOptionalNumber(data, 'tasksCompletedThisWeek', 0, 10000) &&
             isValidOptionalString(data, 'lastActiveDate', 64) &&
             isValidOptionalTimestampField(data, 'createdAt') &&
             isValidOptionalTimestampField(data, 'updatedAt') &&
             isValidOptionalString(data, 'updatedBy', 128) &&
             isValidOptionalString(data, 'migratedFromEmailId', 254) &&
             isValidOptionalTimestampField(data, 'migratedAt');
    }

    function isValidFriendLookupPayload(data, emailHash) {
      return emailHash.matches('^[a-f0-9]{64}$') &&
             data.keys().hasOnly(['uid', 'displayName', 'emailHash', 'updatedAt']) &&
             data.keys().hasAll(['uid', 'displayName', 'emailHash']) &&
             data.uid is string &&
             data.uid.size() > 0 &&
             data.uid.size() <= 254 &&
             data.emailHash is string &&
             data.emailHash == emailHash &&
             data.displayName is string &&
             data.displayName.size() <= 120 &&
             isValidOptionalTimestampField(data, 'updatedAt');
    }

    function isValidFriendProfilePayload(data) {
      let allowedKeys = [
        'uid', 'name', 'displayName', 'institution', 'degreeName',
        'degreeType', 'academicYear', 'status', 'weeklyGoalHours',
        'minutesThisWeek', 'tasksThisWeek', 'currentStreak', 'xp',
        'dailyMinutes', 'subjectMinutes', 'courses', 'updatedAt'
      ];
      return data.keys().hasOnly(allowedKeys) &&
             data.uid is string &&
             data.uid.size() > 0 &&
             data.uid.size() <= 254 &&
             isValidOptionalString(data, 'name', 120) &&
             isValidOptionalString(data, 'displayName', 120) &&
             isValidOptionalString(data, 'institution', 160) &&
             isValidOptionalString(data, 'degreeName', 160) &&
             isValidOptionalString(data, 'degreeType', 80) &&
             isValidOptionalString(data, 'academicYear', 64) &&
             isValidOptionalString(data, 'status', 64) &&
             isValidOptionalNumber(data, 'weeklyGoalHours', 0, 168) &&
             isValidOptionalNumber(data, 'minutesThisWeek', 0, 10080) &&
             isValidOptionalNumber(data, 'tasksThisWeek', 0, 10000) &&
             isValidOptionalNumber(data, 'currentStreak', 0, 10000) &&
             isValidOptionalNumber(data, 'xp', 0, 100000000) &&
             (!('dailyMinutes' in data) || data.dailyMinutes == null || (data.dailyMinutes is map && data.dailyMinutes.size() <= 14)) &&
             (!('subjectMinutes' in data) || data.subjectMinutes == null || (data.subjectMinutes is map && data.subjectMinutes.size() <= 50)) &&
             isValidOptionalList(data, 'courses', 200) &&
             isValidOptionalTimestampField(data, 'updatedAt');
    }

    function isValidFriendshipPayload(data) {
      let allowedKeys = [
        'id', 'users', 'requesterUid', 'requesterName',
        'recipientUid', 'recipientName', 'status', 'createdAt',
        'updatedAt', 'requesterEmail', 'recipientEmail'
      ];
      return data.keys().hasOnly(allowedKeys) &&
             data.users is list &&
             data.users.size() == 2 &&
             data.users[0] is string &&
             data.users[0].size() > 0 &&
             data.users[0].size() <= 254 &&
             data.users[1] is string &&
             data.users[1].size() > 0 &&
             data.users[1].size() <= 254 &&
             data.requesterUid is string &&
             data.requesterUid.size() > 0 &&
             data.requesterUid.size() <= 254 &&
             data.recipientUid is string &&
             data.recipientUid.size() > 0 &&
             data.recipientUid.size() <= 254 &&
             data.requesterUid != data.recipientUid &&
             data.requesterUid in data.users &&
             data.recipientUid in data.users &&
             data.status in ['pending', 'accepted'] &&
             isValidOptionalString(data, 'id', 512) &&
             isValidOptionalString(data, 'requesterName', 120) &&
             isValidOptionalString(data, 'recipientName', 120) &&
             isValidOptionalString(data, 'requesterEmail', 254) &&
             isValidOptionalString(data, 'recipientEmail', 254) &&
             isValidOptionalTimestampField(data, 'createdAt') &&
             isValidOptionalTimestampField(data, 'updatedAt');
    }

    function isValidSquadInvitePayload(data, code) {
      return code.matches('^[A-Z0-9-]{4,20}$') &&
             data.keys().hasOnly(['code', 'squadId', 'createdBy', 'createdAt']) &&
             data.keys().hasAll(['code', 'squadId', 'createdBy']) &&
             data.code is string &&
             data.code == code &&
             data.squadId is string &&
             data.squadId.size() > 0 &&
             data.squadId.size() <= 128 &&
             data.createdBy is string &&
             data.createdBy.size() > 0 &&
             data.createdBy.size() <= 254 &&
             isValidOptionalTimestampField(data, 'createdAt');
    }

    function isValidSquadPayload(data) {
      let allowedKeys = [
        'id', 'name', 'code', 'description', 'weeklyGoalHours', 'nextSession',
        'createdAt', 'createdBy', 'creatorName', 'memberCount', 'memberUids', 'updatedAt'
      ];
      return data.keys().hasOnly(allowedKeys) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             (!('code' in data) || (data.code is string && data.code.size() >= 4 && data.code.size() <= 20)) &&
             isValidOptionalString(data, 'id', 128) &&
             isValidOptionalString(data, 'description', 500) &&
             isValidOptionalNumber(data, 'weeklyGoalHours', 1, 1000) &&
             (!('nextSession' in data) || data.nextSession == null || (data.nextSession is map && data.nextSession.size() <= 10)) &&
             isValidOptionalString(data, 'createdBy', 254) &&
             isValidOptionalString(data, 'creatorName', 120) &&
             isValidOptionalNumber(data, 'memberCount', 0, 500) &&
             isValidOptionalList(data, 'memberUids', 200) &&
             isValidOptionalTimestampField(data, 'createdAt') &&
             isValidOptionalTimestampField(data, 'updatedAt');
    }

    function isValidSquadMember(data, memberId) {
      let allowedKeys = [
        'uid', 'displayName', 'email', 'color', 'elo',
        'minutesThisWeek', 'tasksThisWeek', 'currentStreak',
        'joinedAt', 'updatedAt', 'avatarUrl',
        'dailyMinutes', 'subjectMinutes', 'status', 'liveSubject',
        'liveStartedAt', 'nudgeCount', 'lastNudgedBy', 'lastNudgedAt'
      ];
      return memberId is string &&
             memberId.size() > 0 &&
             memberId.size() <= 254 &&
             data.keys().hasOnly(allowedKeys) &&
             isValidOptionalString(data, 'uid', 254) &&
             isValidOptionalString(data, 'displayName', 120) &&
             isValidOptionalString(data, 'email', 254) &&
             isValidOptionalString(data, 'color', 32) &&
             isValidOptionalNumber(data, 'elo', 0, 1000000) &&
             isValidOptionalNumber(data, 'minutesThisWeek', 0, 10080) &&
             isValidOptionalNumber(data, 'tasksThisWeek', 0, 10000) &&
             isValidOptionalNumber(data, 'currentStreak', 0, 10000) &&
             isValidOptionalString(data, 'joinedAt', 64) &&
             isValidOptionalTimestampField(data, 'updatedAt') &&
             isValidOptionalString(data, 'avatarUrl', 2048) &&
             (!('dailyMinutes' in data) || data.dailyMinutes == null || (data.dailyMinutes is map && data.dailyMinutes.size() <= 14)) &&
             (!('subjectMinutes' in data) || data.subjectMinutes == null || (data.subjectMinutes is map && data.subjectMinutes.size() <= 50)) &&
             isValidOptionalString(data, 'status', 64) &&
             isValidOptionalString(data, 'liveSubject', 160) &&
             isValidOptionalTimestampField(data, 'liveStartedAt') &&
             isValidOptionalNumber(data, 'nudgeCount', 0, 100000) &&
             isValidOptionalString(data, 'lastNudgedBy', 120) &&
             isValidOptionalTimestampField(data, 'lastNudgedAt');
    }

    function isValidSquadSubdoc(data) {
      let allowedKeys = [
        'id', 'uid', 'displayName', 'status', 'subject', 'startedAt',
        'updatedAt', 'type', 'text', 'createdAt', 'durationMinutes',
        'completedAt', 'courseName', 'url', 'title'
      ];
      return data.keys().size() > 0 &&
             data.keys().size() <= 25 &&
             data.keys().hasOnly(allowedKeys) &&
             isValidOptionalString(data, 'id', 128) &&
             isValidOptionalString(data, 'uid', 254) &&
             isValidOptionalString(data, 'displayName', 120) &&
             isValidOptionalString(data, 'status', 64) &&
             isValidOptionalString(data, 'subject', 160) &&
             isValidOptionalString(data, 'courseName', 160) &&
             isValidOptionalString(data, 'url', 2048) &&
             isValidOptionalString(data, 'title', 200) &&
             isValidOptionalString(data, 'type', 64) &&
             isValidOptionalString(data, 'text', 500) &&
             isValidOptionalNumber(data, 'durationMinutes', 0, 1440) &&
             isValidOptionalTimestampField(data, 'startedAt') &&
             isValidOptionalTimestampField(data, 'updatedAt') &&
             isValidOptionalTimestampField(data, 'createdAt') &&
             isValidOptionalTimestampField(data, 'completedAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User profile and academic telemetry (owner-only; legacy email ID permitted get/delete for one-time migration)
    match /users/{userId} {
      allow get, delete: if isUserDocOwner(userId) || isLegacyEmailOwner(userId);
      allow list: if false;
      allow create: if isUserDocOwner(userId) &&
                      !('passwordHash' in request.resource.data) &&
                      isValidUserPayload(request.resource.data, userId);
      allow update: if isUserDocOwner(userId) &&
                      !('passwordHash' in request.resource.data) &&
                      isValidUserPayload(request.resource.data, userId) &&
                      (!('createdAt' in resource.data) ||
                       !('createdAt' in request.resource.data) ||
                       request.resource.data.createdAt == resource.data.createdAt);
    }

    // Exact-email SHA-256 lookup index for friend requests (zero-enumeration)
    match /friendLookups/{emailHash} {
      allow get: if isSignedIn() && emailHash.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create: if isSignedIn() &&
                      isValidFriendLookupPayload(request.resource.data, emailHash) &&
                      request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
                      resource.data.uid == request.auth.uid &&
                      isValidFriendLookupPayload(request.resource.data, emailHash) &&
                      request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Privacy-separated, grade-free friend telemetry projection
    match /friendProfiles/{userId} {
      allow get: if isUserDocOwner(userId) || isAcceptedFriendOf(userId);
      allow list: if false;
      allow create, update: if isUserDocOwner(userId) &&
                              request.resource.data.uid == request.auth.uid &&
                              !('grades' in request.resource.data) &&
                              !('passwordHash' in request.resource.data) &&
                              isValidFriendProfilePayload(request.resource.data);
      allow delete: if isUserDocOwner(userId);
    }

    // UID-keyed bidirectional friendships & friend requests
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() && (
                     (resource != null &&
                      (request.auth.uid in resource.data.users ||
                       (authEmail() != '' && authEmail() in resource.data.users))) ||
                     (resource == null &&
                      (friendshipId.matches('^' + request.auth.uid + '__.*$') ||
                       friendshipId.matches('^.*__' + request.auth.uid + '$')))
                   );
      allow list: if isSignedIn() &&
                    (request.auth.uid in resource.data.users ||
                     (authEmail() != '' && authEmail() in resource.data.users));
      allow create: if isSignedIn() &&
                      friendshipId.size() > 0 &&
                      friendshipId.size() <= 512 &&
                      isValidFriendshipPayload(request.resource.data) &&
                      request.resource.data.requesterUid == request.auth.uid &&
                      request.auth.uid in request.resource.data.users &&
                      request.resource.data.status == 'pending' &&
                      (!('id' in request.resource.data) || request.resource.data.id == friendshipId) &&
                      friendshipId == (request.resource.data.users[0] < request.resource.data.users[1]
                        ? request.resource.data.users[0] + '__' + request.resource.data.users[1]
                        : request.resource.data.users[1] + '__' + request.resource.data.users[0]);
      allow update: if isSignedIn() &&
                      isValidFriendshipPayload(request.resource.data) &&
                      request.auth.uid == resource.data.recipientUid &&
                      request.auth.uid in resource.data.users &&
                      resource.data.status == 'pending' &&
                      request.resource.data.status == 'accepted' &&
                      request.resource.data.users == resource.data.users &&
                      request.resource.data.requesterUid == resource.data.requesterUid &&
                      request.resource.data.recipientUid == resource.data.recipientUid &&
                      (!('createdAt' in resource.data) ||
                       !('createdAt' in request.resource.data) ||
                       request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isSignedIn() &&
                      (request.auth.uid in resource.data.users ||
                       (authEmail() != '' && authEmail() in resource.data.users));
    }

    // Invite-code lookup documents for joining squads without listing /squads
    match /squadInvites/{code} {
      allow get: if isSignedIn() && code.matches('^[A-Z0-9-]{4,20}$');
      allow list: if false;
      allow create: if isSignedIn() &&
                      isValidSquadInvitePayload(request.resource.data, code) &&
                      request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() &&
                      (resource.data.createdBy == request.auth.uid ||
                       isSquadCreator(resource.data.squadId));
    }

    // Squads Hub: Main squad document and subcollections
    match /squads/{squadId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() &&
                    (request.auth.uid in resource.data.memberUids ||
                     (legacyEmailDocId() != '' && legacyEmailDocId() in resource.data.memberUids));
      allow create: if isSignedIn() &&
                      squadId.size() > 0 &&
                      squadId.size() <= 128 &&
                      isValidSquadPayload(request.resource.data) &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 0 &&
                      request.resource.data.code is string &&
                      request.resource.data.code.size() >= 4 &&
                      request.resource.data.createdBy == request.auth.uid &&
                      request.resource.data.memberUids is list &&
                      request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn() &&
                      squadId.size() > 0 &&
                      squadId.size() <= 128 &&
                      isValidSquadPayload(request.resource.data) &&
                      (!('createdAt' in resource.data) ||
                       !('createdAt' in request.resource.data) ||
                       request.resource.data.createdAt == resource.data.createdAt) &&
                      (
                        // (a) Joining via invite: non-member adds only their own UID
                        (!(request.auth.uid in resource.data.memberUids) &&
                         request.auth.uid in request.resource.data.memberUids &&
                         request.resource.data.createdBy == resource.data.createdBy &&
                         request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
                         request.resource.data.memberUids.size() <= resource.data.memberUids.size() + 1 &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])) ||
                        // (b) Existing member, creator, or legacy migration updates
                        ((request.auth.uid in resource.data.memberUids ||
                          (legacyEmailDocId() != '' && legacyEmailDocId() in resource.data.memberUids)) &&
                         (
                           (request.resource.data.createdBy == resource.data.createdBy &&
                            ((resource.data.createdBy == request.auth.uid ||
                              (legacyEmailDocId() != '' && resource.data.createdBy == legacyEmailDocId())) ||
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'nextSession', 'updatedAt']))) ||
                           (request.resource.data.createdBy != resource.data.createdBy &&
                            (resource.data.createdBy == request.auth.uid ||
                             (legacyEmailDocId() != '' && resource.data.createdBy == legacyEmailDocId())) &&
                            (request.resource.data.createdBy in resource.data.memberUids ||
                             request.resource.data.createdBy == request.auth.uid))
                         ))
                      );
      allow delete: if isSignedIn() &&
                      (resource.data.createdBy == request.auth.uid ||
                       (legacyEmailDocId() != '' && resource.data.createdBy == legacyEmailDocId())) &&
                      resource.data.memberUids.size() <= 1;

      // Squad members
      match /members/{memberId} {
        allow get, list: if isSignedIn() &&
                            (isSquadMember(squadId) || isLegacySquadMember(squadId));
        allow create, update: if isSignedIn() &&
                                (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                                (request.auth.uid == memberId ||
                                 (legacyEmailDocId() != '' && legacyEmailDocId() == memberId)) &&
                                isValidSquadMember(request.resource.data, memberId);
        allow delete: if isSignedIn() &&
                        (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                        (request.auth.uid == memberId ||
                         (legacyEmailDocId() != '' && legacyEmailDocId() == memberId) ||
                         isSquadCreator(squadId) ||
                         isLegacySquadCreator(squadId));
      }

      // Live Lock-In presence
      match /presence/{memberId} {
        allow get, list: if isSignedIn() &&
                            (isSquadMember(squadId) || isLegacySquadMember(squadId));
        allow create, update: if isSignedIn() &&
                                memberId.size() > 0 &&
                                memberId.size() <= 254 &&
                                (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                                (request.auth.uid == memberId ||
                                 (legacyEmailDocId() != '' && legacyEmailDocId() == memberId)) &&
                                isValidSquadSubdoc(request.resource.data);
        allow delete: if isSignedIn() &&
                        (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                        (request.auth.uid == memberId ||
                         (legacyEmailDocId() != '' && legacyEmailDocId() == memberId) ||
                         isSquadCreator(squadId) ||
                         isLegacySquadCreator(squadId));
      }

      // Squad activity feed
      match /activities/{activityId} {
        allow get, list: if isSignedIn() &&
                            (isSquadMember(squadId) || isLegacySquadMember(squadId));
        allow create, update: if isSignedIn() &&
                                activityId.size() > 0 &&
                                activityId.size() <= 254 &&
                                (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                                isValidSquadSubdoc(request.resource.data);
        allow delete: if isSignedIn() &&
                        (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                        (resource.data.uid == request.auth.uid ||
                         (legacyEmailDocId() != '' && resource.data.uid == legacyEmailDocId()) ||
                         isSquadCreator(squadId) ||
                         isLegacySquadCreator(squadId));
      }

      // Historical ghost racing sessions
      match /sessions/{sessionId} {
        allow get, list: if isSignedIn() &&
                            (isSquadMember(squadId) || isLegacySquadMember(squadId));
        allow create, update: if isSignedIn() &&
                                sessionId.size() > 0 &&
                                sessionId.size() <= 254 &&
                                (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                                (request.resource.data.uid == request.auth.uid ||
                                 isSquadCreator(squadId) ||
                                 isLegacySquadCreator(squadId)) &&
                                isValidSquadSubdoc(request.resource.data);
        allow delete: if isSignedIn() &&
                        (isSquadMember(squadId) || isLegacySquadMember(squadId)) &&
                        (resource.data.uid == request.auth.uid ||
                         (legacyEmailDocId() != '' && resource.data.uid == legacyEmailDocId()) ||
                         isSquadCreator(squadId) ||
                         isLegacySquadCreator(squadId));
      }
    }

    // Legacy / deprecated collections (explicitly locked down)
    match /emailVerifications/{docId} {
      allow read, write: if false;
    }

    match /mail/{docId} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read, write: if false;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
